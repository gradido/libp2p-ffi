# A home router: forwards its LAN to the public network through NAT, and lets nothing in that the
# LAN did not ask for.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends iptables iproute2 && rm -rf /var/lib/apt/lists/*
COPY router.sh /usr/local/bin/router.sh
ENTRYPOINT ["/usr/local/bin/router.sh"]
